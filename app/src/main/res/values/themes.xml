<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.IronMind" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.IronMind.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#050505</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/system_splash_icon_blank</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.IronMind</item>
    </style>

    <!-- Professional Transparent Theme for Focus Overlays -->
    <style name="Theme.Transparent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowIsFloating">true</item>
    </style>

    <style name="Theme.IronMind.LockScreen" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#04070C</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
